# Copy to .env. Default mock mode works without an API key.
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TEMPERATURE=0
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
GOLDEN_DATA_PATH=data/golden_it_support_tickets.csv
SESSION_CAPTURE_PATH=data/session_captures.jsonl

# Authentication (change these before any shared/deployed demo)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=60
DEMO_USERNAME=squad4-user
DEMO_PASSWORD=ChangeMe123!
DEMO_ADMIN_USERNAME=squad4-admin
DEMO_ADMIN_PASSWORD=ChangeAdmin123!
